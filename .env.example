# Pooled Supabase connection string, used by the app at runtime.
POSTGRES_URL=

# Direct (non-pooling) Supabase connection string, used by drizzle-kit push/migrations.
POSTGRES_URL_NON_POOLING=

# Anthropic API key for the AI skill-generation endpoint (Phase 2).
ANTHROPIC_API_KEY=

# Salt used to hash visitor IPs before rate-limit storage — never store raw IPs.
FSGA_IP_SALT=

# Password gating the admin UI (Phase 2).
FSGA_ADMIN_PASSWORD=
